app: vscode
-
open changed files: user.run_rpc_command("gitInlineChanges.openAllChanged")
tree changed files: user.run_rpc_command("gitInlineChanges.showChangedInTree")
mark review: user.run_rpc_command("gitInlineChanges.markReviewed")
clear review: user.run_rpc_command("gitInlineChanges.clearReviewed")
clear all reviews: user.run_rpc_command("gitInlineChanges.clearAllReviewed")
open review files: user.run_rpc_command("gitInlineChanges.openReviewed")
