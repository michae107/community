app: godot_voice_editor
-
tag(): user.tabs
# Explicit Godot-only context. No global dictation or catch-all focus rule.
godot voice status: user.godot_voice_command("status")
godot marks on: user.godot_voice_command("hints.show")
godot marks off: user.godot_voice_command("hints.hide")
godot marks reset: user.godot_voice_command("hints.reset")

bar (tree | explore | file): user.godot_voice_focus("files")
bar inspector: user.godot_voice_focus("inspector")
bar node: user.godot_voice_focus("scene")
bar signals: user.godot_voice_focus("signals")
bar groups: user.godot_voice_focus("groups")
bar import: user.godot_voice_focus("import")
bar history: user.godot_voice_focus("history")
panel output: user.godot_voice_focus("output")
panel debugger: user.godot_voice_focus("debugger")
panel animation: user.godot_voice_focus("animation")
panel audio: user.godot_voice_focus("audio")
panel shader: user.godot_voice_focus("shader")
bar script: user.godot_voice_focus("Script")
bar two: user.godot_voice_focus("2D")
bar three: user.godot_voice_focus("3D")
bar game: user.godot_voice_focus("Game")
view two: user.godot_voice_focus("viewport2d")
view three: user.godot_voice_focus("viewport3d")
focus editor: user.godot_voice_focus("editor")
view selected: user.godot_voice_action("view", "focus_selection")
view origin: user.godot_voice_action("view", "focus_origin")
view front: user.godot_voice_action("view", "front_view")
view back: user.godot_voice_action("view", "rear_view")
view left: user.godot_voice_action("view", "left_view")
view right: user.godot_voice_action("view", "right_view")
view top: user.godot_voice_action("view", "top_view")
view bottom: user.godot_voice_action("view", "bottom_view")
view grid: user.godot_voice_action("view", "view_grid")
view local: user.godot_voice_action("view", "local_coords")
view snap: user.godot_voice_action("view", "snap")
tool select: user.godot_voice_action("view", "tool_select")
tool move: user.godot_voice_action("view", "tool_move")
tool rotate: user.godot_voice_action("view", "tool_rotate")
tool scale: user.godot_voice_action("view", "tool_scale")
dock <user.letters>: user.godot_voice_target("tree.select", "docks", letters)

node <user.letters>: user.godot_voice_target("tree.toggle", "scene", letters)
node <user.letters> <number>: user.godot_voice_target("tree.expand", "scene", letters, number)
node <number> <user.letters>: user.godot_voice_target("tree.expand", "scene", letters, number)
node select <user.letters>: user.godot_voice_target("tree.select", "scene", letters)
node open <user.letters>: user.godot_voice_target("tree.open", "scene", letters)
node toggle <user.letters>: user.godot_voice_target("tree.toggle", "scene", letters)
node expand <user.letters>: user.godot_voice_target("tree.expand", "scene", letters)
node expand <user.letters> <number_small>: user.godot_voice_target("tree.expand", "scene", letters, number_small)
node collapse <user.letters>: user.godot_voice_target("tree.collapse", "scene", letters)
node parent <user.letters>: user.godot_voice_target("tree.parent", "scene", letters)
node rename <user.letters>: user.godot_voice_target("tree.rename", "scene", letters)
node duplicate <user.letters>: user.godot_voice_target("tree.duplicate", "scene", letters)
node delete <user.letters>: user.godot_voice_target("tree.delete", "scene", letters)
node copy path <user.letters>: user.godot_voice_target("tree.copy_path", "scene", letters)
node root: user.godot_voice_tree("tree.root", "scene")
node collapse all: user.godot_voice_tree("tree.collapse_all", "scene")
node next: user.godot_voice_tree_key("scene", "down")
node last: user.godot_voice_tree_key("scene", "up")
node page down: user.godot_voice_tree_key("scene", "page_down")
node page up: user.godot_voice_tree_key("scene", "page_up")
node hunt: user.godot_voice_search("scene")
node hunt <user.text>: user.godot_voice_search("scene", text)
node hunt clear: user.godot_voice_search("scene")
node script: user.godot_voice_command("scene.script")
node add: user.godot_voice_action("scene", "add_child_node")
node instance: user.godot_voice_action("scene", "instantiate_scene")
node copy: user.godot_voice_action("scene", "copy_node")
node cut: user.godot_voice_action("scene", "cut_node")
node paste: user.godot_voice_action("scene", "paste_node")
node paste sibling: user.godot_voice_action("scene", "paste_node_as_sibling")
node move up: user.godot_voice_action("scene", "move_up")
node move down: user.godot_voice_action("scene", "move_down")
node reparent: user.godot_voice_action("scene", "reparent")
node change type: user.godot_voice_action("scene", "change_node_type")
node attach script: user.godot_voice_action("scene", "attach_script")
node unique: user.godot_voice_action("scene", "toggle_unique_name")
node save branch: user.godot_voice_action("scene", "save_branch_as_scene")
node reveal: user.godot_voice_action("scene", "show_in_file_system")
node visibility: user.godot_voice_shortcut("editor/toggle_selected_nodes_visibility")
node lock: user.godot_voice_shortcut("editor/lock_selected_nodes")
node unlock: user.godot_voice_shortcut("editor/unlock_selected_nodes")

(file | tree) <user.letters>: user.godot_voice_target("tree.toggle", "files", letters)
(file | tree) <user.letters> <number>: user.godot_voice_target("tree.expand", "files", letters, number)
(file | tree) <number> <user.letters>: user.godot_voice_target("tree.expand", "files", letters, number)
(file | tree) open <user.letters>: user.godot_voice_target("tree.open", "files", letters)
(file | tree) select <user.letters>: user.godot_voice_target("tree.select", "files", letters)
(file | tree) expand <user.letters>: user.godot_voice_target("tree.expand", "files", letters)
(file | tree) expand <user.letters> <number_small>: user.godot_voice_target("tree.expand", "files", letters, number_small)
(file | tree) collapse <user.letters>: user.godot_voice_target("tree.collapse", "files", letters)
(file | tree) rename <user.letters>: user.godot_voice_target("tree.rename", "files", letters)
(file | tree) delete <user.letters>: user.godot_voice_target("tree.delete", "files", letters)
(file | tree) copy path <user.letters>: user.godot_voice_target("tree.copy_path", "files", letters)
(file | tree) root: user.godot_voice_tree("tree.root", "files")
(file | tree) collapse all: user.godot_voice_tree("tree.collapse_all", "files")
(file | tree) next: user.godot_voice_tree_key("files", "down")
(file | tree) last: user.godot_voice_tree_key("files", "up")
(file | tree) page down: user.godot_voice_tree_key("files", "page_down")
(file | tree) page up: user.godot_voice_tree_key("files", "page_up")
(file | tree) parent: user.godot_voice_command("files.up")
(file | tree) reveal: user.godot_voice_command("files.reveal")
(file | tree) hunt: user.godot_voice_search("files")
(file | tree) hunt <user.text>: user.godot_voice_search("files", text)
(file | tree) hunt clear: user.godot_voice_search("files")
(file | tree) new folder: user.godot_voice_action("files", "new_folder")
(file | tree) new scene: user.godot_voice_action("files", "new_scene")
(file | tree) new script: user.godot_voice_action("files", "new_script")
(file | tree) new resource: user.godot_voice_action("files", "new_resource")
(file | tree) duplicate: user.godot_voice_action("files", "duplicate")
(file | tree) terminal: user.godot_voice_action("files", "open_in_terminal")
(file | tree) path: user.godot_voice_action("files", "focus_path")

script <user.letters>: user.godot_voice_target("tree.open", "scripts", letters)
script next: user.godot_voice_action("script", "next_script")
script last: user.godot_voice_action("script", "prev_script")
script close: user.godot_voice_action("script", "close_file")
script save: user.godot_voice_action("script", "save")
script save all: user.godot_voice_action("script", "save_all")
script back: user.godot_voice_action("script", "history_previous")
script forward: user.godot_voice_action("script", "history_next")

# Basic tab grammar comes from core/windows_and_tabs/tabs.talon, like VS Code.
# Letter targeting follows rango-talon/src/rango.talon.
(go tab | slot) <user.letters>: user.godot_voice_target("tree.select", "tabs", letters)
godot scene new: user.godot_voice_shortcut("editor/new_scene")
godot scene open: user.godot_voice_shortcut("editor/open_scene")
godot quick open: user.godot_voice_shortcut("editor/quick_open")
godot commands: user.godot_voice_shortcut("editor/command_palette")
godot undo: user.godot_voice_shortcut("ui_undo")
godot redo: user.godot_voice_shortcut("ui_redo")
godot cancel: user.godot_voice_command("editor.cancel")
godot project settings: user.godot_voice_shortcut("editor/project_settings")
godot editor settings: user.godot_voice_shortcut("editor/editor_settings")
godot save: user.godot_voice_command("editor.save")
godot save all: user.godot_voice_command("editor.save_all")
godot run: user.godot_voice_command("editor.run")
godot run scene: user.godot_voice_command("editor.run_scene")
godot stop: user.godot_voice_command("editor.stop")
godot scan: user.godot_voice_command("editor.scan")
godot zen: user.godot_voice_command("editor.distraction")
